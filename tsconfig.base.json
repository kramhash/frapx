{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@frapx/core": ["./packages/core/src/index.ts"],
      "@frapx/core/*": ["./packages/core/src/*.ts"],
      "@frapx/fx-canvas": ["./packages/fx-canvas/src/index.ts"],
      "@frapx/fx-canvas/*": ["./packages/fx-canvas/src/*.ts"],
      "@frapx/react-canvas": ["./packages/react-canvas/src/index.ts"],
      "@frapx/glsl-noise": ["./packages/glsl-noise/src/index.ts"],
      "@frapx/glsl-flowmap": ["./packages/glsl-flowmap/src/index.ts"],
      "@frapx/glsl-sdf-volume": ["./packages/glsl-sdf-volume/src/index.ts"],
      "@frapx/fx-particles": ["./packages/fx-particles/src/index.ts"],
      "@frapx/react-particles": ["./packages/react-particles/src/index.ts"]
    }
  }
}
