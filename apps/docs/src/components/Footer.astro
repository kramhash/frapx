---
// Starlight's footer plus a link to the privacy page (GA4, growth plan decision 41).
import Default from "@astrojs/starlight/components/Footer.astro";
---

<Default />
<p class="privacy-link">
  <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/privacy/`}>Privacy</a>
</p>

<style>
  .privacy-link {
    margin-top: 1rem;
    font-size: var(--sl-text-xs);
    text-align: center;
  }
  .privacy-link a {
    color: var(--sl-color-gray-3);
  }
</style>
