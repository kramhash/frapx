exports[`generateInstallCode > react tab 1`] = `
"// npm install @frapx/react-canvas @frapx/fx-canvas @frapx/glsl-noise
import { ShaderBackground } from "@frapx/react-canvas";
import { glsl, glslUtils } from "@frapx/fx-canvas";
import { fbm3d } from "@frapx/glsl-noise";

const fragment = glsl\`
precision highp float;

uniform vec2 u_resolution;
uniform float u_time;
uniform float u_speed; // @range 0 4 @default 1.5
uniform vec3 u_tint; // @color @default #ff8000

\${fbm3d}
\${glslUtils.rotate2d}

void main() {
  vec2 uv = gl_FragCoord.xy / u_resolution;
  gl_FragColor = vec4(u_tint * frapx_fbm3d(vec3(uv, u_time * u_speed)), 1.0);
}
\`;

export function Hero() {
  return (
    <section style={{ position: "relative", minHeight: "100vh" }}>
      <ShaderBackground
        fragment={fragment}
        uniforms={{
          speed: 0.25,
          tint: [1, 0.502, 0]
        }}
        // Holds a still frame when the visitor asks the OS to reduce motion.
        respectReducedMotion
        // Stops drawing while the tab is in the background.
        pauseWhenHidden
        // The background is decorative; hide it from assistive technology.
        aria-hidden="true"
        style={{ position: "absolute", inset: 0 }}
      />
      <div style={{ position: "relative", zIndex: 1, padding: "2rem" }}>
        <h1>Hello</h1>
      </div>
    </section>
  );
}
"
`;

exports[`generateInstallCode > vanilla tab 1`] = `
"// npm install @frapx/fx-canvas @frapx/glsl-noise
import { createShaderBackground, glsl, glslUtils } from "@frapx/fx-canvas";
import { fbm3d } from "@frapx/glsl-noise";

const fragment = glsl\`
precision highp float;

uniform vec2 u_resolution;
uniform float u_time;
uniform float u_speed; // @range 0 4 @default 1.5
uniform vec3 u_tint; // @color @default #ff8000

\${fbm3d}
\${glslUtils.rotate2d}

void main() {
  vec2 uv = gl_FragCoord.xy / u_resolution;
  gl_FragColor = vec4(u_tint * frapx_fbm3d(vec3(uv, u_time * u_speed)), 1.0);
}
\`;

createShaderBackground({
  target: ".hero",
  fragment,
  uniforms: {
    speed: 0.25,
    tint: [1, 0.502, 0]
  },
  // Holds a still frame when the visitor asks the OS to reduce motion.
  respectReducedMotion: true,
  // Stops drawing while the tab is in the background.
  pauseWhenHidden: true,
  onReady(instance) {
    // The background is decorative; hide it from assistive technology.
    instance.canvas?.setAttribute("aria-hidden", "true");
  }
});
"
`;

exports[`generateInstallCode with baked volumes > astro tab with a zstd volume 1`] = `
"---
// npm install @frapx/fx-canvas @frapx/glsl-sdf-volume fzstd
// The runtime needs the browser, so it runs in <script>, not in this frontmatter.
---

<section class="hero">
  <div class="hero-content">
    <h1>Hello</h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    padding: 2rem;
  }
</style>

<script>
  import { createShaderBackground, glsl } from "@frapx/fx-canvas";
  import { loadSdfVolume } from "@frapx/glsl-sdf-volume";
  import { decompress } from "fzstd";

  const fragment = glsl\`#version 300 es
  precision highp float;
  uniform highp sampler3D u_sdf; // @volume suzanne
  uniform float u_level; // @range 0 1 @default 0.5
  out vec4 fragColor;
  void main() { fragColor = vec4(u_level); }
  \`;

  // Serve Suzanne.r8-zstd.sdf.ktx2 at /sdf/Suzanne.r8-zstd.sdf.ktx2 (e.g. put it in public/sdf/).
  loadSdfVolume("/sdf/Suzanne.r8-zstd.sdf.ktx2", {
    zstd: (bytes, size) => decompress(bytes, new Uint8Array(size))
  }).then((bakedSdf) => {
    createShaderBackground({
      target: ".hero",
      fragment,
      textures: {
        sdf: bakedSdf.texture
      },
      uniforms: {
        ...bakedSdf.uniforms("sdf"),
        level: 0.5
      },
      // Holds a still frame when the visitor asks the OS to reduce motion.
      respectReducedMotion: true,
      // Stops drawing while the tab is in the background.
      pauseWhenHidden: true,
      onReady(instance) {
        // The background is decorative; hide it from assistive technology.
        instance.canvas?.setAttribute("aria-hidden", "true");
      }
    });
  });
</script>
"
`;

