{
  "name": "@frapx/react-canvas",
  "version": "1.0.0",
  "description": "React bindings for @frapx/fx-canvas.",
  "keywords": [
    "webgl",
    "shader",
    "react",
    "canvas",
    "background",
    "visual-effects"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@frapx/fx-canvas": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kramhash/frapx.git",
    "directory": "packages/react-canvas"
  },
  "homepage": "https://kramhash.github.io/frapx/packages/react-canvas/",
  "bugs": {
    "url": "https://github.com/kramhash/frapx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
