{
  "name": "@frapx/core",
  "version": "0.8.0",
  "description": "Shared WebGL runtime host for frapx packages.",
  "keywords": [
    "webgl",
    "webgl2",
    "shader",
    "glsl",
    "runtime",
    "frapx"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./glsl": {
      "types": "./dist/glsl.d.ts",
      "import": "./dist/glsl.js"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "import": "./dist/color.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kramhash/frapx.git",
    "directory": "packages/core"
  },
  "homepage": "https://kramhash.github.io/frapx/packages/core/",
  "bugs": {
    "url": "https://github.com/kramhash/frapx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
